{
  "info": {
    "name": "NutriAI",
    "_postman_id": "nutriai-collection",
    "description": "NutriAI backend API collection. Grows feature-by-feature.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "conversationId", "value": "" },
    { "key": "assetId", "value": "" },
    { "key": "uploadUrl", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "GET /auth/google (open in browser)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/google", "host": ["{{baseUrl}}"], "path": ["auth", "google"] },
            "description": "Open this URL in a browser to start the Google OAuth flow. Postman cannot follow Google's interactive consent screen."
          }
        },
        {
          "name": "POST /auth/dev-login (NODE_ENV != production)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@nutriai.test\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/dev-login", "host": ["{{baseUrl}}"], "path": ["auth", "dev-login"] },
            "description": "Dev-only: upserts a user by email and returns an access + refresh token pair. Gated off in production."
          }
        },
        {
          "name": "POST /auth/refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "description": "Rotates refresh token and returns a new access token. Cookie is preferred; body fallback is provided for API clients."
          }
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Food",
      "item": [
        {
          "name": "POST /analyze-food (text)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"2 scrambled eggs, 1 slice of whole wheat toast, and a medium banana\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/analyze-food", "host": ["{{baseUrl}}"], "path": ["analyze-food"] }
          }
        },
        {
          "name": "POST /analyze-food (image url)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imageUrl\": \"https://upload.wikimedia.org/wikipedia/commons/6/6d/Good_Food_Display_-_NCI_Visuals_Online.jpg\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/analyze-food", "host": ["{{baseUrl}}"], "path": ["analyze-food"] }
          }
        },
        {
          "name": "POST /analyze-food (assetId)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetId\": \"{{assetId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/analyze-food", "host": ["{{baseUrl}}"], "path": ["analyze-food"] },
            "description": "Analyze a previously uploaded image. Run the Uploads folder (presign → PUT → confirm) first."
          }
        }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "POST /uploads/presign",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.assetId) pm.collectionVariables.set('assetId', json.assetId);",
                  "if (json.uploadUrl) pm.collectionVariables.set('uploadUrl', json.uploadUrl);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contentType\": \"image/jpeg\",\n  \"size\": 245760\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/uploads/presign",
              "host": ["{{baseUrl}}"],
              "path": ["uploads", "presign"]
            },
            "description": "Returns { assetId, uploadUrl, key, bucket, expiresIn, requiredHeaders }. PUT the file bytes to uploadUrl with the returned Content-Type."
          }
        },
        {
          "name": "PUT uploadUrl (direct to S3)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "image/jpeg" }],
            "body": {
              "mode": "file",
              "file": { "src": "" }
            },
            "url": { "raw": "{{uploadUrl}}", "host": ["{{uploadUrl}}"] },
            "description": "Upload file bytes directly to the presigned S3 URL. Select a local image in the Body tab."
          }
        },
        {
          "name": "POST /uploads/confirm",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetId\": \"{{assetId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/uploads/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["uploads", "confirm"]
            }
          }
        }
      ]
    },
    {
      "name": "History",
      "item": [
        {
          "name": "GET /history",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/history?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["history"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "from", "value": "", "disabled": true },
                { "key": "to", "value": "", "disabled": true },
                { "key": "minCalories", "value": "", "disabled": true },
                { "key": "maxCalories", "value": "", "disabled": true }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "POST /chat (new conversation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.conversationId) pm.collectionVariables.set('conversationId', json.conversationId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"How many calories are in a medium banana?\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/chat", "host": ["{{baseUrl}}"], "path": ["chat"] }
          }
        },
        {
          "name": "POST /chat (follow-up in same conversation)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"And how does that compare to an apple?\",\n  \"conversationId\": \"{{conversationId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/chat", "host": ["{{baseUrl}}"], "path": ["chat"] }
          }
        },
        {
          "name": "GET /chat/conversations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/chat/conversations",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "conversations"]
            }
          }
        },
        {
          "name": "GET /chat/conversations/:id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/chat/conversations/{{conversationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "conversations", "{{conversationId}}"]
            }
          }
        },
        {
          "name": "DELETE /chat/conversations/:id",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/chat/conversations/{{conversationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "conversations", "{{conversationId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Recommendations",
      "item": [
        {
          "name": "GET /recommendations/meals",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/recommendations/meals?limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["recommendations", "meals"],
              "query": [
                { "key": "limit", "value": "5" },
                { "key": "mealType", "value": "DINNER", "disabled": true },
                { "key": "remainingCalories", "value": "800", "disabled": true },
                { "key": "remainingProtein", "value": "40", "disabled": true }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "GET /analytics/daily (last 7 days)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/analytics/daily",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "daily"],
              "query": [
                { "key": "from", "value": "", "disabled": true },
                { "key": "to", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "GET /analytics/macros?from=...&to=...",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/analytics/macros?from=2026-04-10&to=2026-04-16",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "macros"],
              "query": [
                { "key": "from", "value": "2026-04-10" },
                { "key": "to", "value": "2026-04-16" }
              ]
            }
          }
        },
        {
          "name": "GET /analytics/streak",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/analytics/streak",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "streak"]
            }
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "GET /profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/profile", "host": ["{{baseUrl}}"], "path": ["profile"] }
          }
        },
        {
          "name": "PUT /profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sex\": \"MALE\",\n  \"birthYear\": 1996,\n  \"heightCm\": 180,\n  \"weightKg\": 80,\n  \"activityLevel\": \"MODERATE\",\n  \"goal\": \"MAINTAIN\",\n  \"dietaryPrefs\": [\"high-protein\"],\n  \"allergies\": [\"peanuts\"],\n  \"dailyBudgetUsd\": 20,\n  \"timezone\": \"America/Los_Angeles\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/profile", "host": ["{{baseUrl}}"], "path": ["profile"] }
          }
        },
        {
          "name": "DELETE /profile",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/profile", "host": ["{{baseUrl}}"], "path": ["profile"] }
          }
        }
      ]
    },
    {
      "name": "Meals",
      "item": [
        {
          "name": "POST /meals (from items)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mealType\": \"BREAKFAST\",\n  \"items\": [\n    { \"name\": \"oatmeal\", \"calories\": 150, \"protein\": 5, \"carbs\": 27, \"fat\": 3 },\n    { \"name\": \"banana\", \"calories\": 105, \"protein\": 1.3, \"carbs\": 27, \"fat\": 0.4 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/meals", "host": ["{{baseUrl}}"], "path": ["meals"] }
          }
        },
        {
          "name": "POST /meals (snapshot from foodQueryId)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mealType\": \"LUNCH\",\n  \"foodQueryId\": \"REPLACE_WITH_QUERY_ID\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/meals", "host": ["{{baseUrl}}"], "path": ["meals"] }
          }
        },
        {
          "name": "GET /meals?date=YYYY-MM-DD",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/meals?date=2026-04-16",
              "host": ["{{baseUrl}}"],
              "path": ["meals"],
              "query": [{ "key": "date", "value": "2026-04-16" }]
            }
          }
        },
        {
          "name": "GET /meals/daily-summary?date=YYYY-MM-DD",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/meals/daily-summary?date=2026-04-16",
              "host": ["{{baseUrl}}"],
              "path": ["meals", "daily-summary"],
              "query": [{ "key": "date", "value": "2026-04-16" }]
            }
          }
        },
        {
          "name": "DELETE /meals/:id",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/meals/MEAL_ID",
              "host": ["{{baseUrl}}"],
              "path": ["meals", "MEAL_ID"]
            }
          }
        }
      ]
    },
    {
      "name": "Api Keys",
      "item": [
        {
          "name": "POST /api-keys",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"partner-prod\",\n  \"scopes\": [\"calories:read\"],\n  \"rateLimitPerMin\": 120\n}"
            },
            "url": { "raw": "{{baseUrl}}/api-keys", "host": ["{{baseUrl}}"], "path": ["api-keys"] }
          }
        },
        {
          "name": "GET /api-keys",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api-keys", "host": ["{{baseUrl}}"], "path": ["api-keys"] }
          }
        },
        {
          "name": "DELETE /api-keys/:id",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api-keys/API_KEY_ID",
              "host": ["{{baseUrl}}"],
              "path": ["api-keys", "API_KEY_ID"]
            }
          }
        }
      ]
    },
    {
      "name": "Public API",
      "item": [
        {
          "name": "POST /v1/public/calories (text, x-api-key)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"2 boiled eggs and a slice of whole wheat toast\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/public/calories",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "public", "calories"]
            }
          }
        },
        {
          "name": "POST /v1/public/calories (imageUrl, Bearer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imageUrl\": \"https://example.com/meal.jpg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/public/calories",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "public", "calories"]
            }
          }
        }
      ]
    }
  ]
}
