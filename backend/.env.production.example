NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://app.yourdomain.com
TRUST_PROXY=1

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
REDIS_URL=rediss://default:PASSWORD@HOST:6379

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_FAIL_OPEN=false
READINESS_CHECK_TIMEOUT_MS=1500
METRICS_BEARER_TOKEN=replace_with_32_plus_random_chars

JWT_ACCESS_SECRET=replace_with_32_plus_random_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/google/callback
FRONTEND_POST_LOGIN_URL=https://app.yourdomain.com/auth/callback
FRONTEND_URL=https://app.yourdomain.com

RESEND_API_KEY=
EMAIL_FROM=NutriAI <noreply@yourdomain.com>
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
UPLOAD_PRESIGN_TTL_SECONDS=300
UPLOAD_MAX_SIZE_BYTES=10485760

AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL_TEXT=gpt-4o-mini
AI_MODEL_VISION=gpt-4o
AI_MODEL_CHAT=gpt-4o-mini
GEMINI_API_KEY=
USDA_API_KEY=
AI_CACHE_TTL_SECONDS=86400
AI_CHAT_CACHE_TTL_SECONDS=3600
AI_CHAT_HISTORY_WINDOW=8
AI_CHAT_DAILY_MESSAGE_LIMIT=5
AI_CHAT_MAX_WORDS=100
AI_CHAT_MAX_OUTPUT_TOKENS=220
AI_FOOD_TEXT_MAX_WORDS=40
AI_IMAGE_DAILY_LIMIT=3
AI_DAILY_BUDGET_USD=2
AI_REQUEST_TIMEOUT_MS=25000
AI_MAX_CONCURRENT_REQUESTS=20
AI_QUEUE_TIMEOUT_MS=2000
ENABLE_DIGEST_JOBS=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_TOKEN_TTL_MINUTES=10
TELEGRAM_PENDING_ACTION_TTL_MINUTES=15
