// NutriAI Prisma schema.
// Models are added feature-by-feature.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id         String   @id @default(uuid())
  googleId   String?  @unique
  email      String   @unique
  name       String?
  avatarUrl  String?
  role       Role     @default(USER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  refreshTokens RefreshToken[]
  foodQueries   FoodQuery[]
  tokenUsage    TokenUsage[]
  meals         Meal[]

  @@index([email])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum FoodInputType {
  TEXT
  IMAGE
}

model FoodQuery {
  id             String        @id @default(uuid())
  userId         String?
  inputType      FoodInputType
  inputText      String?
  imageUrl       String?
  inputHash      String
  totalCalories  Float
  totalProtein   Float
  totalCarbs     Float
  totalFat       Float
  confidence     Float
  provider       String
  model          String
  cached         Boolean       @default(false)
  createdAt      DateTime      @default(now())

  items    FoodItem[]
  user     User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([inputHash])
}

model FoodItem {
  id         String   @id @default(uuid())
  queryId    String
  name       String
  quantity   String?
  calories   Float
  protein    Float
  carbs      Float
  fat        Float
  confidence Float?

  query FoodQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@index([name])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model Meal {
  id             String   @id @default(uuid())
  userId         String
  mealType       MealType
  loggedAt       DateTime
  notes          String?
  foodQueryId    String?
  totalCalories  Float
  totalProtein   Float
  totalCarbs     Float
  totalFat       Float
  createdAt      DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealItem[]

  @@index([userId, loggedAt])
  @@index([userId, mealType])
}

model MealItem {
  id       String  @id @default(uuid())
  mealId   String
  name     String
  quantity String?
  calories Float
  protein  Float
  carbs    Float
  fat      Float

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
}

model TokenUsage {
  id               String   @id @default(uuid())
  userId           String?
  endpoint         String
  provider         String
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  costUsd          Float
  cached           Boolean  @default(false)
  latencyMs        Int
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([endpoint, createdAt])
}
