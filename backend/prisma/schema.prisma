// NutriAI Prisma schema.
// Models are added feature-by-feature.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id              String    @id @default(uuid())
  googleId        String?   @unique
  email           String    @unique
  name            String?
  avatarUrl       String?
  passwordHash    String?
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  role            Role      @default(USER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  foodQueries             FoodQuery[]
  tokenUsage              TokenUsage[]
  meals                   Meal[]
  conversations           Conversation[]
  assets                  Asset[]
  profile                 UserProfile?
  apiKeys                 ApiKey[]
  userChallenges          UserChallenge[]
  weightEntries           WeightEntry[]
  telegramAccount         TelegramAccount?
  telegramLinkTokens      TelegramLinkToken[]
  telegramPendingActions  TelegramPendingAction[]
  ownedFamilies           Family[]                @relation("OwnedFamilies")
  familyMemberships       FamilyMember[]          @relation("FamilyMemberships")
  familyInvitesSent       FamilyInvite[]          @relation("FamilyInvitesSent")

  @@index([email])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum FoodInputType {
  TEXT
  IMAGE
}

model FoodQuery {
  id             String        @id @default(uuid())
  userId         String?
  assetId        String?
  inputType      FoodInputType
  inputText      String?
  imageUrl       String?
  inputHash      String
  totalCalories  Float
  totalProtein   Float
  totalCarbs     Float
  totalFat       Float
  confidence     Float
  provider       String
  model          String
  cached         Boolean       @default(false)
  createdAt      DateTime      @default(now())

  items                  FoodItem[]
  user                   User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  asset                  Asset?                  @relation(fields: [assetId], references: [id], onDelete: SetNull)
  telegramPendingActions TelegramPendingAction[]

  @@index([userId, createdAt])
  @@index([inputHash])
  @@index([assetId])
}

model FoodItem {
  id         String   @id @default(uuid())
  queryId    String
  name       String
  quantity   String?
  calories   Float
  protein    Float
  carbs      Float
  fat        Float
  confidence Float?

  query FoodQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@index([name])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model Meal {
  id             String   @id @default(uuid())
  userId         String
  mealType       MealType
  loggedAt       DateTime
  notes          String?
  foodQueryId    String?
  totalCalories  Float
  totalProtein   Float
  totalCarbs     Float
  totalFat       Float
  createdAt      DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealItem[]

  @@index([userId, loggedAt])
  @@index([userId, mealType])
}

model MealItem {
  id       String  @id @default(uuid())
  mealId   String
  name     String
  quantity String?
  calories Float
  protein  Float
  carbs    Float
  fat      Float

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
}

model ApiKey {
  id          String    @id @default(uuid())
  userId      String
  name        String
  prefix      String    @unique
  tokenHash   String    @unique
  scopes      String[]  @default([])
  rateLimitPerMin Int   @default(60)
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  usage ApiUsage[]

  @@index([userId])
  @@index([revokedAt])
}

model ApiUsage {
  id         String   @id @default(uuid())
  apiKeyId   String
  endpoint   String
  statusCode Int
  latencyMs  Int
  createdAt  DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, createdAt])
  @@index([endpoint, createdAt])
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
}

model UserProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  sex             Sex?
  birthYear       Int?
  heightCm        Float?
  weightKg        Float?
  activityLevel   ActivityLevel?
  goal            Goal?
  targetWeightKg  Float?
  dailyCalorieTarget Int?
  proteinTargetG  Int?
  carbsTargetG    Int?
  fatTargetG      Int?
  dietaryPrefs    String[]       @default([])
  allergies       String[]       @default([])
  dailyBudgetUsd      Float?
  timezone            String?
  notifyStreakRisk     Boolean        @default(false)
  notifyWeeklyDigest  Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Family analytics sharing ───────────────────────────────────────────────

enum FamilyRole {
  OWNER
  VIEWER
}

enum FamilyInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Family {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User           @relation("OwnedFamilies", fields: [ownerId], references: [id], onDelete: Cascade)
  members FamilyMember[]
  invites FamilyInvite[]

  @@index([ownerId])
}

model FamilyMember {
  id              String     @id @default(uuid())
  familyId        String
  userId          String
  role            FamilyRole @default(VIEWER)
  analyticsAccess Boolean    @default(true)
  joinedAt        DateTime   @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation("FamilyMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
  @@index([familyId])
}

model FamilyInvite {
  id              String             @id @default(uuid())
  familyId        String
  inviterId       String
  email           String
  tokenHash       String             @unique
  role            FamilyRole         @default(VIEWER)
  analyticsAccess Boolean            @default(true)
  status          FamilyInviteStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  family  Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  inviter User   @relation("FamilyInvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([inviterId])
  @@index([email])
  @@index([status, expiresAt])
}

enum AssetStatus {
  PENDING
  UPLOADED
}

model Asset {
  id          String      @id @default(uuid())
  userId      String
  bucket      String
  key         String      @unique
  contentType String
  size        Int?
  status      AssetStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  uploadedAt  DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodQueries FoodQuery[]

  @@index([userId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model TokenUsage {
  id               String   @id @default(uuid())
  userId           String?
  endpoint         String
  provider         String
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  costUsd          Float
  cached           Boolean  @default(false)
  latencyMs        Int
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([endpoint, createdAt])
}

model AppSettings {
  id                        String   @id @default("default")
  aiDailyBudgetUsd          Float?
  aiChatDailyMessageLimit   Int?
  aiChatMaxWords            Int?
  aiChatHistoryWindow       Int?
  aiChatMaxOutputTokens     Int?
  aiFoodTextMaxWords        Int?
  aiImageDailyLimit         Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

// ── Challenges ──────────────────────────────────────────────────────────────

enum ChallengeCategory {
  SUGAR
  PROTEIN
  HYDRATION
  CALORIES
  STEPS
  HABIT
}

enum ChallengeStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

// Preset challenge templates (seeded, not user-created).
model Challenge {
  id           String            @id @default(uuid())
  slug         String            @unique
  title        String
  description  String
  category     ChallengeCategory
  durationDays Int
  icon         String            // emoji
  createdAt    DateTime          @default(now())

  userChallenges UserChallenge[]

  @@index([category])
  @@index([durationDays])
}

// A user's participation in a preset or custom challenge.
model UserChallenge {
  id              String          @id @default(uuid())
  userId          String
  challengeId     String?         // null for custom challenges
  title           String
  description     String?
  durationDays    Int
  startDate       DateTime        @default(now())
  status          ChallengeStatus @default(ACTIVE)
  daysCheckedIn   Int             @default(0)
  lastCheckInDate DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, createdAt])
}

// ── Weight tracking ─────────────────────────────────────────────────────────

model WeightEntry {
  id         String   @id @default(uuid())
  userId     String
  weightKg   Decimal  @db.Decimal(5, 2)
  note       String?
  recordedAt DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt(sort: Desc)])
}

// ── Telegram bot integration ───────────────────────────────────────────────

model TelegramAccount {
  id             String    @id @default(uuid())
  userId         String    @unique
  telegramUserId String    @unique
  chatId         String
  username       String?
  firstName      String?
  lastName       String?
  linkedAt       DateTime  @default(now())
  lastSeenAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([telegramUserId])
  @@index([chatId])
}

model TelegramLinkToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TelegramPendingAction {
  id             String   @id @default(uuid())
  telegramUserId String
  userId         String
  foodQueryId    String
  messageId      String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodQuery FoodQuery @relation(fields: [foodQueryId], references: [id], onDelete: Cascade)

  @@index([telegramUserId])
  @@index([userId])
  @@index([foodQueryId])
  @@index([expiresAt])
}
