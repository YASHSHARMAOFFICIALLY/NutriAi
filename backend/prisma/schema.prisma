// NutriAI Prisma schema.
// Models are added feature-by-feature.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id         String   @id @default(uuid())
  googleId   String?  @unique
  email      String   @unique
  name       String?
  avatarUrl  String?
  role       Role     @default(USER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  refreshTokens RefreshToken[]
  foodQueries   FoodQuery[]
  tokenUsage    TokenUsage[]
  meals         Meal[]
  conversations Conversation[]
  assets        Asset[]
  profile       UserProfile?

  @@index([email])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum FoodInputType {
  TEXT
  IMAGE
}

model FoodQuery {
  id             String        @id @default(uuid())
  userId         String?
  assetId        String?
  inputType      FoodInputType
  inputText      String?
  imageUrl       String?
  inputHash      String
  totalCalories  Float
  totalProtein   Float
  totalCarbs     Float
  totalFat       Float
  confidence     Float
  provider       String
  model          String
  cached         Boolean       @default(false)
  createdAt      DateTime      @default(now())

  items FoodItem[]
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([inputHash])
  @@index([assetId])
}

model FoodItem {
  id         String   @id @default(uuid())
  queryId    String
  name       String
  quantity   String?
  calories   Float
  protein    Float
  carbs      Float
  fat        Float
  confidence Float?

  query FoodQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@index([name])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model Meal {
  id             String   @id @default(uuid())
  userId         String
  mealType       MealType
  loggedAt       DateTime
  notes          String?
  foodQueryId    String?
  totalCalories  Float
  totalProtein   Float
  totalCarbs     Float
  totalFat       Float
  createdAt      DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealItem[]

  @@index([userId, loggedAt])
  @@index([userId, mealType])
}

model MealItem {
  id       String  @id @default(uuid())
  mealId   String
  name     String
  quantity String?
  calories Float
  protein  Float
  carbs    Float
  fat      Float

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
}

model UserProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  sex             Sex?
  birthYear       Int?
  heightCm        Float?
  weightKg        Float?
  activityLevel   ActivityLevel?
  goal            Goal?
  targetWeightKg  Float?
  dailyCalorieTarget Int?
  proteinTargetG  Int?
  carbsTargetG    Int?
  fatTargetG      Int?
  dietaryPrefs    String[]       @default([])
  allergies       String[]       @default([])
  dailyBudgetUsd  Float?
  timezone        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AssetStatus {
  PENDING
  UPLOADED
}

model Asset {
  id          String      @id @default(uuid())
  userId      String
  bucket      String
  key         String      @unique
  contentType String
  size        Int?
  status      AssetStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  uploadedAt  DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodQueries FoodQuery[]

  @@index([userId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model TokenUsage {
  id               String   @id @default(uuid())
  userId           String?
  endpoint         String
  provider         String
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  costUsd          Float
  cached           Boolean  @default(false)
  latencyMs        Int
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([endpoint, createdAt])
}
