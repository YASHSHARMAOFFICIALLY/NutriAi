# ---- Runtime ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://nutriai:nutriai@localhost:5432/nutriai?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT (populated in Feature 1) ----
JWT_ACCESS_SECRET=replace_me_with_long_random_string
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Google OAuth (populated in Feature 1) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ---- AWS S3 (populated in Feature 6) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ---- AI providers (populated in Feature 2) ----
OPENAI_API_KEY=
AI_PROVIDER=openai
AI_MODEL_TEXT=gpt-4o-mini
AI_MODEL_VISION=gpt-4o

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
