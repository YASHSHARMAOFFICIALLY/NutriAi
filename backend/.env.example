# ---- Runtime ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# ---- Database ----
DATABASE_URL=postgresql://nutriai:nutriai@localhost:5432/nutriai?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT (populated in Feature 1) ----
JWT_ACCESS_SECRET=replace_me_with_long_random_string
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
FRONTEND_POST_LOGIN_URL=http://localhost:3000/auth/callback
FRONTEND_URL=http://localhost:3000

# ---- Email (Resend) ----
# Get an API key at https://resend.com. If unset, emails are logged to stdout (dev only).
RESEND_API_KEY=
EMAIL_FROM=NutriAI <noreply@nutriai.local>
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

# ---- AWS S3 ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Set AWS_S3_ENDPOINT + AWS_S3_FORCE_PATH_STYLE=true for LocalStack / MinIO.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
UPLOAD_PRESIGN_TTL_SECONDS=300
UPLOAD_MAX_SIZE_BYTES=10485760

# ---- AI providers ----
# AI_PROVIDER: openai (default) | gemini | stub
AI_PROVIDER=openai

# OpenAI (active by default)
OPENAI_API_KEY=
AI_MODEL_TEXT=gpt-4o-mini
AI_MODEL_VISION=gpt-4o
AI_MODEL_CHAT=gpt-4o-mini

# Gemini (set AI_PROVIDER=gemini + install @google/generative-ai to activate)
GEMINI_API_KEY=

# USDA FoodData Central (free nutrition DB lookup — Tier 2 before OpenAI)
# DEMO_KEY = 30 req/hr. Get a free key at https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=DEMO_KEY

AI_CACHE_TTL_SECONDS=86400
AI_CHAT_CACHE_TTL_SECONDS=3600
AI_CHAT_HISTORY_WINDOW=8
AI_CHAT_DAILY_MESSAGE_LIMIT=5
AI_CHAT_MAX_WORDS=100
AI_CHAT_MAX_OUTPUT_TOKENS=220
AI_FOOD_TEXT_MAX_WORDS=40
AI_IMAGE_DAILY_LIMIT=3
AI_DAILY_BUDGET_USD=2

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- Telegram bot ----
# Create a bot with @BotFather, set webhook to POST /telegram/webhook, and keep the token server-side.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_TOKEN_TTL_MINUTES=10
TELEGRAM_PENDING_ACTION_TTL_MINUTES=15
